static double vypocitejPrumer(double[] pole)

{
    double soucet = 0;

    for (int i = 0; i < pole.Length; i++)
    {
        soucet += pole[i]; // return pole.Average();
    }
    return soucet / pole.Length;
}
  

Console.WriteLine($"Aritmetický průměr: {Math.Round(vypocitejPrumer(poleHodnot), 2)}");
