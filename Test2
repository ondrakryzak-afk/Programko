// ukol 2

double[] pole = { 10, 20, 30, 40, 50, 60, 71 };

static double vypocitejPrumer(double[] pole)
{
    double soucet = 0;

    for (int i = 0; i < pole.Length; i++)
    {
        soucet += pole[i];
    }

    return soucet / pole.Length;
}

Console.WriteLine($"Aritmetický průměr: {vypocitejPrumer(pole)}");

